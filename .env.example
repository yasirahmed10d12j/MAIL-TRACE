# ---- MailTrace configuration ----
# Copy this file to .env and fill in real values.

# Public URL where this server is reachable (tracking pixel must be fetchable
# by the recipient's mail client — localhost only works for local testing).
# For real use: run on a VPS / tunnel (ngrok, cloudflared) and put that URL here.
BASE_URL=http://127.0.0.1:5000

# Gmail example (needs App Password: myaccount.google.com > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Ahmed <you@gmail.com>"

# Outlook/Office365: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Zoho:             SMTP_HOST=smtp.zoho.com    SMTP_PORT=465
